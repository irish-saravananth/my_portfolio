:root {
  --bg: #07090a;
  --surface: #0b0e0f;
  --surface-soft: #0e1213;
  --text: #f2f4f5;
  --muted: #7890a6;
  --muted-soft: #526477;
  --accent: #7df9a7;
  --accent-soft: rgba(125, 249, 167, 0.08);
  --accent-border: rgba(125, 249, 167, 0.24);
  --border: rgba(255, 255, 255, 0.10);
  --border-soft: rgba(255, 255, 255, 0.06);
  --max-width: 1440px;
}

/* =========================================================
   RESET
   ========================================================= */

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
  background: var(--bg);
}

body {
  margin: 0;
  min-width: 320px;
  background: var(--bg);
  color: var(--text);
  font-family:
    Inter,
    ui-sans-serif,
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;
}

button,
a {
  font: inherit;
}

a {
  color: inherit;
  text-decoration: none;
}

::selection {
  background: var(--accent);
  color: #07100a;
}

#root {
  min-height: 100vh;
  overflow-x: clip;
}

.app {
  min-height: 100vh;
  background:
    radial-gradient(
      circle at 75% 10%,
      rgba(125, 249, 167, 0.035),
      transparent 30%
    ),
    var(--bg);
}

/* =========================================================
   NAVIGATION
   ========================================================= */

.navbar {
  position: sticky;
  top: 0;
  z-index: 100;
  width: 100%;
  height: 74px;
  border-bottom: 1px solid var(--border-soft);
  background: rgba(7, 9, 10, 0.90);
  backdrop-filter: blur(18px);
}

.navbar-inner {
  width: min(var(--max-width), 84%);
  height: 100%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-logo {
  font-size: 1rem;
  font-weight: 800;
  letter-spacing: -0.04em;
}

.nav-links {
  display: flex;
  align-items: center;
  gap: 34px;
}

.nav-links a {
  color: #8290a0;
  font-size: 0.76rem;
  transition: color 180ms ease;
}

.nav-links a:hover {
  color: var(--text);
}

.nav-github {
  display: inline-flex;
  align-items: center;
  gap: 10px;
  padding: 11px 16px;
  border: 1px solid var(--border);
  border-radius: 8px;
  color: var(--text) !important;
  font-weight: 650;
}

.nav-github:hover {
  border-color: var(--accent-border);
  background: var(--accent-soft);
}

/* =========================================================
   SHARED SECTION LABELS
   ========================================================= */

.section-kicker {
  margin: 0 0 24px;
  color: #8ca3b8;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.78rem;
  font-weight: 600;
  letter-spacing: 0.18em;
  line-height: 1.4;
  text-transform: uppercase;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
}

.section-heading h2 {
  max-width: 900px;
  margin: 0;
  font-size: clamp(2.8rem, 4.8vw, 5.2rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
  font-weight: 800;
}

.stack-label {
  display: flex;
  align-items: center;
  gap: 14px;
  margin: 64px 0 20px;
  color: var(--accent);
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.70rem;
  font-weight: 600;
  letter-spacing: 0.16em;
}

.stack-line {
  display: inline-block;
  width: 30px;
  height: 1px;
  background: var(--accent);
  flex: 0 0 auto;
}

/* =========================================================
   HERO
   ========================================================= */

.hero {
  position: relative;
  min-height: calc(100vh - 74px);
  display: grid;
  grid-template-columns: minmax(0, 1.05fr) minmax(360px, 0.75fr);
  align-items: center;
  gap: 70px;
  padding: 90px 8% 100px;
  border-bottom: 1px solid var(--border);
  overflow: hidden;
  background:
    radial-gradient(
      circle at 75% 50%,
      rgba(125, 249, 167, 0.045),
      transparent 34%
    ),
    linear-gradient(
      135deg,
      rgba(255, 255, 255, 0.012),
      transparent 48%
    );
}

.hero-grid {
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: 0.16;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.025) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.025) 1px, transparent 1px);
  background-size: 80px 80px;
  mask-image: linear-gradient(to bottom, black, transparent 80%);
}

.hero-content {
  position: relative;
  z-index: 1;
  max-width: 880px;
}

.hero-badge {
  display: inline-flex;
  align-items: center;
  gap: 11px;
  margin-bottom: 34px;
  padding: 10px 16px;
  border: 1px solid var(--accent-border);
  border-radius: 999px;
  color: var(--accent);
  background: rgba(125, 249, 167, 0.025);
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.62rem;
  font-weight: 600;
  letter-spacing: 0.12em;
}

.hero-badge::before {
  content: "";
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--accent);
  box-shadow: 0 0 14px rgba(125, 249, 167, 0.5);
}

.hero-eyebrow {
  display: flex;
  align-items: center;
  gap: 12px;
  margin-bottom: 34px;
  color: #8aa0b4;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.63rem;
  letter-spacing: 0.16em;
}

.hero-eyebrow::before {
  content: ">_";
  color: var(--accent);
  font-size: 1rem;
}

.hero h1 {
  margin: 0;
  font-size: clamp(3.8rem, 6.8vw, 6.8rem);
  line-height: 0.84;
  letter-spacing: -0.075em;
  font-weight: 850;
}

.hero h1 span {
  display: block;
  color: var(--accent);
}

.hero-description {
  max-width: 820px;
  margin: 48px 0 34px;
  color: #7d94aa;
  font-size: 1rem;
  line-height: 1.85;
}

.hero-actions {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.primary-button,
.secondary-button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  min-height: 58px;
  padding: 0 24px;
  border-radius: 8px;
  font-size: 0.78rem;
  font-weight: 750;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.primary-button {
  background: var(--accent);
  color: #07100a;
}

.primary-button:hover {
  transform: translateY(-2px);
}

.secondary-button {
  border: 1px solid var(--border);
  color: var(--text);
}

.secondary-button:hover {
  border-color: var(--accent-border);
  background: var(--accent-soft);
}

.hero-socials {
  display: flex;
  align-items: center;
  gap: 28px;
  margin-top: 34px;
}

.hero-socials a {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #8194a7;
  font-size: 0.72rem;
}

.hero-socials a:hover {
  color: var(--accent);
}

/* =========================================================
   TERMINAL
   ========================================================= */

.terminal-card {
  position: relative;
  z-index: 1;
  width: 100%;
  min-height: 475px;
  border: 1px solid var(--border);
  border-radius: 12px;
  overflow: hidden;
  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(125, 249, 167, 0.025),
      transparent 45%
    ),
    #090c0d;
  box-shadow: 0 30px 90px rgba(0, 0, 0, 0.22);
}

.terminal-header {
  height: 52px;
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 0 18px;
  border-bottom: 1px solid var(--border);
}

.terminal-dots {
  display: flex;
  gap: 7px;
}

.terminal-dots span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #3d454c;
}

.terminal-title {
  margin-left: 10px;
  color: #526477;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.58rem;
}

.terminal-body {
  padding: 34px 32px;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.66rem;
  line-height: 1.8;
}

.terminal-line {
  display: flex;
  gap: 14px;
  margin-bottom: 22px;
}

.terminal-prompt {
  color: var(--accent);
}

.terminal-command {
  color: var(--text);
  font-weight: 700;
}

.terminal-output {
  margin: -12px 0 24px;
  color: #7289a0;
}

.terminal-success {
  color: var(--accent);
}

.terminal-muted {
  color: #435362;
}

.scroll-indicator {
  position: absolute;
  bottom: 28px;
  left: 8%;
  color: #617488;
}

/* =========================================================
   MAJOR SECTION SPACING + ALIGNMENT
   ========================================================= */

.about-section,
.flow-section,
.skills-section,
.projects-section,
.experience-section,
.contact-section {
  width: 100%;
  padding-left: 8%;
  padding-right: 8%;
  padding-top: 90px;
  padding-bottom: 90px;
}

/* =========================================================
   ABOUT
   ========================================================= */

.about-section {
  padding-top: 90px;
  padding-bottom: 75px;
  border-bottom: 1px solid var(--border);
}

.about-grid {
  display: grid;
  grid-template-columns: 0.55fr 1.45fr;
  gap: 80px;
}

.about-copy {
  max-width: 960px;
}

.about-copy h2 {
  max-width: 1000px;
  margin: 0;
  font-size: clamp(2.8rem, 4.8vw, 5.2rem);
  line-height: 0.96;
  letter-spacing: -0.06em;
  font-weight: 800;
}

.about-copy > p {
  max-width: 900px;
  margin: 42px 0 0;
  color: #7b92a8;
  font-size: 0.95rem;
  line-height: 1.9;
}

.about-points {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  margin-top: 52px;
}

.about-point {
  display: flex;
  gap: 20px;
  min-height: 160px;
  padding: 24px;
  border: 1px solid var(--border);
  border-radius: 9px;
  background: rgba(255, 255, 255, 0.008);
  transition:
    border-color 180ms ease,
    transform 180ms ease;
}

.about-point:hover {
  transform: translateY(-2px);
  border-color: var(--accent-border);
}

.about-point > span {
  color: var(--accent);
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.58rem;
  line-height: 1.5;
}

.about-point h3 {
  margin: 0;
  font-size: 0.72rem;
}

.about-point p {
  margin: 11px 0 0;
  color: #687f94;
  font-size: 0.63rem;
  line-height: 1.7;
}

/* =========================================================
   ENGINEERING WORKFLOW
   ========================================================= */

.flow-section {
  padding-top: 75px;
  border-bottom: 1px solid var(--border);
  position: relative;
  overflow: hidden;
}

.flow-heading {
  max-width: 1200px;
}

.flow-heading .section-kicker {
  margin-bottom: 26px;
}

.flow-heading h2 {
  max-width: 1000px;
  margin: 0;
  font-size: clamp(2.8rem, 5vw, 5.2rem);
  line-height: 0.94;
  letter-spacing: -0.065em;
  font-weight: 800;
}

.flow-description {
  max-width: 1050px;
  margin: 40px 0 60px;
  color: #7890a6;
  font-size: 0.88rem;
  line-height: 1.8;
}

.flow-grid {
  width: 100%;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.flow-card {
  position: relative;
  min-height: 230px;
  padding: 28px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.012),
      rgba(255, 255, 255, 0)
    ),
    rgba(8, 11, 12, 0.72);
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.flow-card:hover {
  transform: translateY(-3px);
  border-color: var(--accent-border);
  background:
    linear-gradient(
      145deg,
      rgba(125, 249, 167, 0.025),
      rgba(255, 255, 255, 0)
    ),
    rgba(8, 11, 12, 0.9);
}

.flow-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  margin-bottom: 24px;
  border: 1px solid var(--accent-border);
  border-radius: 7px;
  color: var(--accent);
  background: var(--accent-soft);
}

.flow-number {
  display: block;
  margin-bottom: 9px;
  color: #8799a8;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.58rem;
}

.flow-card h3 {
  margin: 0;
  color: var(--text);
  font-size: 0.74rem;
  letter-spacing: 0.02em;
}

.flow-card p {
  margin: 13px 0 0;
  color: #62788c;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.56rem;
  line-height: 1.6;
}

/* =========================================================
   SKILLS
   ========================================================= */

.skills-section {
  border-bottom: 1px solid var(--border);
}

.skills-intro {
  max-width: 980px;
  margin: 42px 0 0;
  color: #7890a6;
  font-size: 0.88rem;
  line-height: 1.8;
}

.skills-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.skill-card {
  min-width: 0;
  min-height: 255px;
  padding: 26px;
  border: 1px solid var(--border);
  border-radius: 10px;
  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.012),
      rgba(255, 255, 255, 0)
    ),
    rgba(8, 11, 12, 0.72);
  transition:
    border-color 180ms ease,
    transform 180ms ease,
    background 180ms ease;
}

.skill-card:hover {
  transform: translateY(-3px);
  border-color: var(--accent-border);
  background:
    linear-gradient(
      145deg,
      rgba(125, 249, 167, 0.025),
      rgba(255, 255, 255, 0)
    ),
    rgba(8, 11, 12, 0.9);
}

.skill-card-top {
  min-height: 44px;
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.skill-icon {
  width: 44px;
  height: 44px;
  display: grid;
  place-items: center;
  border: 1px solid var(--accent-border);
  border-radius: 7px;
  color: var(--accent);
  background: var(--accent-soft);
}

.skill-count {
  color: #8495a4;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.58rem;
}

.skill-card h3 {
  margin: 24px 0 0;
  color: var(--text);
  font-size: 0.78rem;
  line-height: 1.35;
  letter-spacing: -0.01em;
}

.skill-description {
  min-height: 42px;
  margin: 12px 0 20px;
  color: #72889c;
  font-size: 0.65rem;
  line-height: 1.7;
}

.skill-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.skill-tags span {
  display: inline-flex;
  align-items: center;
  min-height: 27px;
  padding: 5px 9px;
  border: 1px solid rgba(125, 249, 167, 0.16);
  border-radius: 6px;
  color: #a6b6c5;
  background: rgba(125, 249, 167, 0.025);
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.52rem;
  line-height: 1.3;
}

/* =========================================================
   SOC ENGINEERING
   ========================================================= */

.secondary-stack-label {
  margin-top: 110px;
}

.secondary-skills-intro {
  max-width: 850px;
  margin-bottom: 42px;
}

.secondary-skills-grid {
  display: grid;
  grid-template-columns: repeat(6, minmax(0, 1fr));
  gap: 14px;
}

.secondary-skills-grid .skill-card {
  grid-column: span 2;
  min-height: 270px;
}

.secondary-skills-grid .skill-card:nth-child(4) {
  grid-column: 2 / span 2;
}

.secondary-skills-grid .skill-card:nth-child(5) {
  grid-column: 4 / span 2;
}

/* =========================================================
   PROJECTS
   ========================================================= */

.projects-section {
  padding-top: 75px;
  padding-bottom: 65px;
  border-bottom: 1px solid var(--border);
}

.project-feature {
  margin-top: 72px;
  padding: 40px;
  border: 1px solid var(--border);
  border-radius: 11px;
  background: rgba(255, 255, 255, 0.008);
}

.project-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 30px;
}

.project-eyebrow {
  margin: 0 0 20px;
  color: var(--accent);
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.58rem;
  letter-spacing: 0.18em;
}

.project-header h3 {
  margin: 0;
  font-size: clamp(2rem, 3.5vw, 3.4rem);
  line-height: 1;
  letter-spacing: -0.045em;
}

.project-subtitle {
  margin: 14px 0 0;
  color: #7790a5;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.58rem;
}

.project-github {
  display: inline-flex;
  align-items: center;
  gap: 9px;
  flex: 0 0 auto;
  padding: 12px 16px;
  border: 1px solid var(--border);
  border-radius: 7px;
  color: var(--text);
  font-size: 0.65rem;
  transition:
    border-color 180ms ease,
    background 180ms ease;
}

.project-github:hover {
  border-color: var(--accent-border);
  background: var(--accent-soft);
}

.project-description {
  max-width: 980px;
  margin: 40px 0;
  color: #7890a6;
  font-size: 0.86rem;
  line-height: 1.8;
}

.project-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border-top: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.project-metrics > div {
  min-height: 110px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8px;
  padding: 20px;
  border-right: 1px solid var(--border);
}

.project-metrics > div:last-child {
  border-right: 0;
}

.project-metrics strong {
  font-size: 1.7rem;
  letter-spacing: -0.04em;
}

.project-metrics span {
  color: #667b8e;
  font-size: 0.58rem;
}

.pipeline-heading {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  margin: 36px 0 16px;
  color: #71869a;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.55rem;
  letter-spacing: 0.12em;
}

.project-pipeline {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  border-top: 1px solid var(--border);
  border-left: 1px solid var(--border);
}

.pipeline-step {
  min-height: 180px;
  padding: 20px;
  border-right: 1px solid var(--border);
  border-bottom: 1px solid var(--border);
}

.pipeline-icon {
  width: 38px;
  height: 38px;
  display: grid;
  place-items: center;
  margin-bottom: 20px;
  border: 1px solid var(--accent-border);
  border-radius: 7px;
  color: var(--accent);
  background: var(--accent-soft);
}

.pipeline-number {
  display: block;
  margin-bottom: 7px;
  color: #7c8c99;
  font-size: 0.58rem;
}

.pipeline-step h4 {
  margin: 0;
  font-size: 0.58rem;
  letter-spacing: 0.02em;
}

.pipeline-step p {
  margin: 11px 0 0;
  color: #52687c;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.49rem;
  line-height: 1.55;
}

.project-bottom {
  margin-top: 36px;
  padding-top: 30px;
  border-top: 1px solid var(--border);
}

.project-tech {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.project-tech span {
  padding: 6px 10px;
  border: 1px solid var(--border);
  border-radius: 5px;
  color: #71879a;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.51rem;
}

/* =========================================================
   EXPERIENCE
   ========================================================= */

.experience-section {
  padding-top: 65px;
  padding-bottom: 75px;
  border-bottom: 1px solid var(--border);
}

.experience-heading h2 {
  max-width: 1100px;
  margin: 0;
  font-size: clamp(2.8rem, 5.2vw, 5.5rem);
