/* =========================================================
   SPRINT 1 — SCROLL SECTION PROGRESS
   ========================================================= */

.section-progress {
  position: fixed;
  top: 50%;
  right: 24px;
  z-index: 90;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 11px;
  transform: translateY(-50%);
}

.section-progress-dot {
  position: relative;
  width: 6px;
  height: 6px;
  display: block;
  border: 1px solid rgba(125, 249, 167, 0.42);
  border-radius: 50%;
  background: rgba(125, 249, 167, 0.08);
  transition:
    width 220ms ease,
    height 220ms ease,
    background 220ms ease,
    box-shadow 220ms ease,
    transform 220ms ease;
}

.section-progress-dot:hover {
  transform: scale(1.35);
  background: rgba(125, 249, 167, 0.35);
  border-color: var(--accent);
}

.section-progress-dot--active {
  width: 9px;
  height: 9px;
  border-color: var(--accent);
  background: var(--accent);
  box-shadow: 0 0 14px rgba(125, 249, 167, 0.42);
}

.section-progress-label {
  position: absolute;
  right: 18px;
  top: 50%;
  padding: 5px 8px;
  border: 1px solid var(--border);
  border-radius: 5px;
  background: rgba(7, 9, 10, 0.94);
  color: #8ca3b8;
  font-family:
    "SFMono-Regular",
    Consolas,
    "Liberation Mono",
    monospace;
  font-size: 0.48rem;
  letter-spacing: 0.12em;
  white-space: nowrap;
  opacity: 0;
  pointer-events: none;
  transform: translateY(-50%) translateX(5px);
  transition:
    opacity 160ms ease,
    transform 160ms ease;
}

.section-progress-dot:hover .section-progress-label,
.section-progress-dot--active .section-progress-label {
  opacity: 1;
  transform: translateY(-50%) translateX(0);
}

@media (max-width: 900px) {
  .section-progress {
    right: 14px;
  }
}

@media (max-width: 700px) {
  .section-progress {
    display: none;
  }
}

/* =========================================================
   SPRINT 5 — PHASE 1
   HERO ENTRANCE MOTION
   ========================================================= */

@keyframes sprint5-hero-enter {
  from {
    opacity: 0;
    transform: translate3d(0, 22px, 0);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0);
  }
}

@keyframes sprint5-terminal-enter {
  from {
    opacity: 0;
    transform: translate3d(24px, 0, 0) scale(0.985);
  }

  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
  }
}

@keyframes sprint5-grid-enter {
  from {
    opacity: 0;
  }

  to {
    opacity: 0.16;
  }
}

/* Hero background enters first */

.hero-grid {
  animation:
    sprint5-grid-enter 1200ms
    cubic-bezier(0.22, 1, 0.36, 1)
    both;
}

/* Hero content */

.hero-content > .hero-badge {
  opacity: 0;
  animation:
    sprint5-hero-enter 650ms
    cubic-bezier(0.22, 1, 0.36, 1)
    100ms
    forwards;
}

.hero-content > .hero-eyebrow {
  opacity: 0;
  animation:
    sprint5-hero-enter 650ms
    cubic-bezier(0.22, 1, 0.36, 1)
    220ms
    forwards;
}

.hero-content > h1 {
  opacity: 0;
  animation:
    sprint5-hero-enter 800ms
    cubic-bezier(0.22, 1, 0.36, 1)
    340ms
    forwards;
}

.hero-content > .hero-description {
  opacity: 0;
  animation:
    sprint5-hero-enter 700ms
    cubic-bezier(0.22, 1, 0.36, 1)
    500ms
    forwards;
}

.hero-content > .hero-actions {
  opacity: 0;
  animation:
    sprint5-hero-enter 650ms
    cubic-bezier(0.22, 1, 0.36, 1)
    640ms
    forwards;
}

.hero-content > .hero-socials {
  opacity: 0;
  animation:
    sprint5-hero-enter 650ms
    cubic-bezier(0.22, 1, 0.36, 1)
    760ms
    forwards;
}

/* Hero terminal */

.hero > .terminal-card {
  opacity: 0;
  animation:
    sprint5-terminal-enter 850ms
    cubic-bezier(0.22, 1, 0.36, 1)
    420ms
    forwards;
}

/* Scroll indicator */

.hero > .scroll-indicator {
  opacity: 0;
  animation:
    sprint5-hero-enter 600ms
    cubic-bezier(0.22, 1, 0.36, 1)
    950ms
    forwards;
}

/* =========================================================
   SPRINT 5 — BUTTON MICRO INTERACTION
   ========================================================= */

.primary-button,
.secondary-button,
.nav-github {
  position: relative;
  overflow: hidden;
}

.primary-button::after,
.secondary-button::after,
.nav-github::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(
    110deg,
    transparent 25%,
    rgba(255, 255, 255, 0.08) 50%,
    transparent 75%
  );
  transform: translateX(-120%);
  transition: transform 500ms ease;
  pointer-events: none;
}

.primary-button:hover::after,
.secondary-button:hover::after,
.nav-github:hover::after {
  transform: translateX(120%);
}

/* =========================================================
   SPRINT 5 — HERO TERMINAL MICRO INTERACTION
   ========================================================= */

.hero > .terminal-card {
  transition:
    border-color 250ms ease,
    box-shadow 250ms ease,
    transform 350ms
      cubic-bezier(0.22, 1, 0.36, 1);
}

.hero > .terminal-card:hover {
  border-color: rgba(125, 249, 167, 0.18);
  box-shadow:
    0 34px 95px rgba(0, 0, 0, 0.26),
    0 0 40px rgba(125, 249, 167, 0.025);
  transform: translateY(-3px);
}

/* =========================================================
   SPRINT 5 — REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  .hero-grid,
  .hero-content > .hero-badge,
  .hero-content > .hero-eyebrow,
  .hero-content > h1,
  .hero-content > .hero-description,
  .hero-content > .hero-actions,
  .hero-content > .hero-socials,
  .hero > .terminal-card,
  .hero > .scroll-indicator {
    opacity: 1;
    animation: none;
    transform: none;
  }

  .hero > .terminal-card {
    transition: none;
  }

  .primary-button::after,
  .secondary-button::after,
  .nav-github::after {
    display: none;
  }
}