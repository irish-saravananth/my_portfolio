/* =========================================================
   ABOUT SECTION — ALIGNMENT + TYPOGRAPHY
   ========================================================= */

.about-section {
  width: 100%;
  max-width: none;
  margin: 0;
}

.about-layout {
  display: grid;
  grid-template-columns: 1fr;
}

.about-layout > .section-kicker {
  margin-bottom: 48px;
}

.about-content {
  width: 100%;
}

/* Main About heading */
.about-content h2 {
  max-width: 1050px;
  margin: 0;

  font-size: clamp(3.2rem, 5vw, 5.2rem);
  line-height: 0.96;
  letter-spacing: -0.055em;
  font-weight: 700;
}

/* Introduction */
.about-intro {
  max-width: 1050px;
  margin: 36px 0 52px;

  font-size: 1rem;
  line-height: 1.8;
  color: var(--muted);
}

/* =========================================================
   ABOUT CARDS
   ========================================================= */

.about-points {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
  width: 100%;
}

.about-point {
  min-height: 165px;
  padding: 32px 34px;

  display: grid;
  grid-template-columns: 42px 1fr;
  gap: 12px;

  border: 1px solid var(--border);
  border-radius: 10px;
  background: rgba(255, 255, 255, 0.008);
}

.about-point > span {
  padding-top: 2px;

  font-family: "IBM Plex Mono", monospace;
  font-size: 0.72rem;
  line-height: 1;
  color: var(--accent);
}

.about-point h3 {
  margin: 0 0 20px;

  font-size: 0.9rem;
  line-height: 1.2;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: -0.01em;
}

.about-point p {
  margin: 0;
  max-width: 620px;

  font-size: 0.86rem;
  line-height: 1.7;
  color: var(--muted);
}

/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 1100px) {
  .about-section {
    width: min(100% - 56px, 900px);
  }

  .about-points {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 760px) {
  .about-section {
    width: min(100% - 40px, 680px);
  }

  .about-layout > .section-kicker {
    margin-bottom: 36px;
  }

  .about-content h2 {
    font-size: clamp(2.8rem, 9vw, 4rem);
  }

  .about-intro {
    margin: 30px 0 48px;
  }

  .about-points {
    grid-template-columns: 1fr;
    gap: 12px;
  }

  .about-point {
    min-height: 0;
    padding: 26px 24px;
  }
}

@media (max-width: 480px) {
  .about-section {
    width: calc(100% - 32px);
  }

  .about-point {
    grid-template-columns: 34px 1fr;
    padding: 22px 20px;
  }
}
